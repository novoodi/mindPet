<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SettingsHeader"
            android:text="알림 브리핑" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBriefing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="알림을 읽고 잠금 해제 때 정리해 주기" />

        <TextView
            android:id="@+id/tvRetention"
            style="@style/SettingsValue" />

        <SeekBar
            android:id="@+id/seekRetention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="29" />

        <TextView
            style="@style/SettingsHint"
            android:text="인증번호·OTP 알림은 처음부터 저장하지 않아. 보관 기간이 지나면 원문을 지우고 통계만 남겨." />

        <TextView
            style="@style/SettingsHeader"
            android:text="알림 치우기" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="광고·참여 유도 알림을 펫이 치우기" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoDefer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="덜 급한 알림은 점심·저녁에 모아서 보여 주기" />

        <TextView
            android:id="@+id/tvClearExempt"
            style="@style/SettingsHint" />

        <TextView
            style="@style/SettingsHeader"
            android:text="홈 화면 팝업" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHomePopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="새 브리핑을 홈 화면에 한 번 보여 주기" />

        <Button
            android:id="@+id/btnPreviewPopup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미리 보기" />

        <TextView
            style="@style/SettingsHint"
            android:text="접근성에서 마음펫이 켜져 있어야 보여." />

        <TextView
            style="@style/SettingsHeader"
            android:text="펫 상태" />

        <TextView
            android:id="@+id/tvAccess"
            style="@style/SettingsValue" />

        <TextView
            android:id="@+id/tvNight"
            style="@style/SettingsValue" />

        <TextView
            android:id="@+id/tvNano"
            style="@style/SettingsValue" />

        <TextView
            android:id="@+id/tvLearning"
            style="@style/SettingsValue" />

        <TextView
            android:id="@+id/tvKev"
            style="@style/SettingsValue" />

        <TextView
            style="@style/SettingsHint"
            android:text="Gemini Nano 줄을 누르면 지금 바로 확인해." />
    </LinearLayout>
</ScrollView>
